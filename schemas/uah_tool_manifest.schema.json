{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kirklasalle/unrealagentharness/main/schemas/uah_tool_manifest.schema.json",
  "title": "UAHToolManifest",
  "description": "UAH Standard Specification for AI Agent Function Calling Tools interfacing with Unreal technology.",
  "type": "object",
  "required": ["type", "function"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["function"]
    },
    "function": {
      "type": "object",
      "required": ["name", "description", "parameters"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Identifier of the agentic action tool."
        },
        "description": {
          "type": "string",
          "description": "LLM-facing instructional prompt describing tool capabilities and parameters."
        },
        "parameters": {
          "type": "object",
          "required": ["type", "properties"],
          "properties": {
            "type": { "type": "string", "enum": ["object"] },
            "properties": { "type": "object" },
            "required": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
